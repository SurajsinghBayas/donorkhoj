# ── Runtime ─────────────────────────────────────────────────────────────────
# Set ENV=production on the server (enforces SECRET_KEY strength, tightens CORS)
ENV=development
HOST=0.0.0.0
PORT=8000

# ── Database ──────────────────────────────────────────────────────────────
# Async SQLAlchemy URL. Neon example:
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx-xxxx.aws.neon.tech/neondb?ssl=require
# Optional sync URL for scripts/tools:
SYNC_DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.aws.neon.tech/neondb?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI Agents (OpenRouter) ────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated fallback chains: primary first, fail over on throttle.
MEDICAL_AGENT_MODEL=google/gemma-4-31b-it:free,nex-agi/nex-n2.5-pro:free
MATCHING_AGENT_MODEL=nex-agi/nex-n2.5-pro:free,google/gemma-4-31b-it:free
CHATBOT_MODEL=google/gemma-4-31b-it:free,nex-agi/nex-n2.5-pro:free

# ── CORS ──────────────────────────────────────────────────────────────────
# Extra frontend origin(s), comma-separated (localhost:5173/3000 always allowed)
FRONTEND_URL=
